[mysqld]
# Bind strictly to localhost — external access is managed separately outside the container
bind-address = 127.0.0.1
port = 3306
socket = /run/mysqld/mysqld.sock
datadir = /data/mariadb
skip-name-resolve = 1
symbolic-links = 0

# UTF-8 full support (emojis, filenames, accents)
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Balanced memory footprint (Home-NAS friendly & scalable) + ACID crash durability
innodb_buffer_pool_size = 128M
innodb_log_file_size = 48M
innodb_flush_log_at_trx_commit = 1
innodb_file_per_table = 1
max_connections = 80
max_allowed_packet = 64M
tmp_table_size = 32M
max_heap_table_size = 32M
table_open_cache = 400

[client]
socket = /run/mysqld/mysqld.sock
default-character-set = utf8mb4
