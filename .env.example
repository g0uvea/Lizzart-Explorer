# MariaDB Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lizzart_explorer

# Local Disk Storage Root
STORAGE_ROOT=./storage

# App & Cryptography Config (auto-generated if empty)
APP_NAME="Lizzart Explorer"
APP_MASTER_KEY=
JWT_SECRET=
SESSION_TTL_DAYS=7

# Runtime Performance Profile: ultra_optimized | optimized | fast | ultra_fast
PERFORMANCE_MODE=optimized

# Production HTTP settings
PORT=3000
BODY_SIZE_LIMIT=Infinity
# FORCE_HTTPS=true
# ORIGIN=https://nuvem.seudominio.com
