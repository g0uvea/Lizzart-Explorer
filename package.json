{
	"name": "lizzart-explorer",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "BODY_SIZE_LIMIT=Infinity bunx --bun vite dev",
		"build": "bunx --bun vite build",
		"preview": "BODY_SIZE_LIMIT=Infinity bunx --bun vite preview",
		"start": "BODY_SIZE_LIMIT=Infinity bun ./build/index.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"db:init": "bun run src/lib/server/db/seed.ts",
		"test:e2e": "bun run scripts/verify-e2e.ts",
		"docker:build": "docker build -t lizzart-explorer:latest .",
		"docker:export": "bash scripts/export-docker.sh"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.20.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/vite": "^4.1.4",
		"@types/qrcode": "^1.5.6",
		"svelte": "^5.28.0",
		"svelte-check": "^4.1.6",
		"tailwindcss": "^4.1.4",
		"typescript": "^5.8.3",
		"vite": "^6.3.3"
	},
	"dependencies": {
		"lucide-svelte": "^0.511.0",
		"mysql2": "^3.14.1",
		"qrcode": "^1.5.4"
	}
}
